<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pijon.lightpanda</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LIGHTPANDA_BIN__</string>
    <string>mcp</string>
    <string>--port</string>
    <string>8931</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--http-timeout</string>
    <string>0</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/lightpanda.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/lightpanda.err.log</string>
</dict>
</plist>